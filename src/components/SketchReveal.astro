---
// «Dallo schizzo alla costruzione»: lo schizzo a mano copre la foto dell'opera costruita;
// una linea con scala graduata, trascinabile con mouse, dito o tastiera, passa dall'uno all'altra.
// Nessuna delle due immagini supera la propria dimensione nativa.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { ui, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  sketch: ImageMetadata;
  photo: ImageMetadata;
  sketchAlt: string;
  photoAlt: string;
  built?: string;
  credit?: string;
  title: string;
  class?: string;
}
const { lang, sketch, photo, sketchAlt, photoAlt, built, credit, title, class: cls } = Astro.props;
const steps = [320, 480, 640, 750, 828, 1040];
const widthsFor = (img: ImageMetadata) => [...steps.filter((w) => w < img.width), img.width];
const set = async (img: ImageMetadata, format: 'avif' | 'webp') => {
  const r = await Promise.all(widthsFor(img).map((w) => getImage({ src: img, width: w, format, quality: 80 })));
  return r.map((x) => `${x.src} ${x.attributes.width}w`).join(', ');
};
const [pAvif, pWebp, sAvif, sWebp] = await Promise.all([set(photo, 'avif'), set(photo, 'webp'), set(sketch, 'avif'), set(sketch, 'webp')]);
const pFallback = await getImage({ src: photo, width: photo.width, format: 'jpg', quality: 82 });
const sFallback = await getImage({ src: sketch, width: sketch.width, format: 'jpg', quality: 82 });
const sizes = `(min-width: ${photo.width + 160}px) ${photo.width}px, calc(100vw - 2rem)`;
const sketchSizes = `(min-width: ${sketch.width + 160}px) ${sketch.width}px, calc(100vw - 2rem)`;
const builtTag = `${ui.revealBuilt[lang]}${built ? ` · ${built}` : ''}`;
const creditLabel = { it: 'Foto', de: 'Foto', en: 'Photo' }[lang];
const tickId = `ticks-${Math.random().toString(36).slice(2, 8)}`;
---
<figure class:list={['reveal', cls]} data-reveal style={`--pw:${photo.width}px`}
  data-label-sketch={ui.revealSketch[lang]} data-label-built={ui.revealBuilt[lang]}>
  <div class="reveal-stage" style={`aspect-ratio:${photo.width} / ${photo.height}; --pos:50%; --p:0.5`} data-stage>
    <!-- opera costruita -->
    <picture class="reveal-photo">
      <source type="image/avif" srcset={pAvif} sizes={sizes} />
      <source type="image/webp" srcset={pWebp} sizes={sizes} />
      <img src={pFallback.src} width={photo.width} height={photo.height} alt={photoAlt} loading="lazy" decoding="async" draggable="false" />
    </picture>
    <!-- schizzo, su carta calce, ritagliato fino alla linea -->
    <div class="reveal-sketch">
      <picture>
        <source type="image/avif" srcset={sAvif} sizes={sketchSizes} />
        <source type="image/webp" srcset={sWebp} sizes={sketchSizes} />
        <img src={sFallback.src} width={sketch.width} height={sketch.height} alt={sketchAlt} loading="lazy" decoding="async" draggable="false"
          style={`--sw:${sketch.width}px; --sh:${sketch.height}px`} />
      </picture>
    </div>

    <!-- etichette: toccandole si va al lato corrispondente -->
    <button type="button" class="reveal-tag reveal-tag-sketch t-data" data-snap="100" tabindex="-1">{ui.revealSketch[lang]}</button>
    <button type="button" class="reveal-tag reveal-tag-built t-data" data-snap="0" tabindex="-1">{builtTag}</button>

    <!-- linea con scala graduata e maniglia -->
    <div class="reveal-rule" aria-hidden="true">
      <svg class="reveal-ticks" width="9" height="100%" preserveAspectRatio="none">
        <defs>
          <pattern id={tickId} width="9" height="40" patternUnits="userSpaceOnUse">
            <line x1="0" y1="0.5" x2="9" y2="0.5" />
            <line x1="0" y1="10.5" x2="4" y2="10.5" />
            <line x1="0" y1="20.5" x2="6" y2="20.5" />
            <line x1="0" y1="30.5" x2="4" y2="30.5" />
          </pattern>
        </defs>
        <rect width="9" height="100%" fill={`url(#${tickId})`} />
      </svg>
    </div>
    <div class="reveal-handle" role="slider" tabindex="0" data-handle
      aria-label={`${ui.revealSlider[lang]}: ${title}`} aria-orientation="horizontal"
      aria-valuemin="0" aria-valuemax="100" aria-valuenow="50"
      aria-valuetext={`${ui.revealSketch[lang]} 50%, ${ui.revealBuilt[lang].toLowerCase()} 50%`}>
      <svg width="20" height="12" viewBox="0 0 20 12" aria-hidden="true"><path d="M7 1 2 6l5 5M13 1l5 5-5 5" /></svg>
    </div>
  </div>
  <figcaption class="reveal-caption t-data text-grigio">
    <span>{ui.revealSketch[lang]} · {builtTag}{credit ? ` · ${creditLabel} ${credit}` : ''}</span>
    <span class="reveal-hint">{ui.revealHint[lang]}</span>
  </figcaption>
</figure>

<style is:global>
  @property --pos { syntax: '<percentage>'; inherits: true; initial-value: 50%; }
  .reveal { width: 100%; }
  .reveal-stage {
    position: relative;
    width: 100%;
    max-width: var(--pw);
    overflow: hidden;
    background: var(--color-calce);
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
    cursor: ew-resize;
    outline: 1px solid color-mix(in oklch, var(--color-pietra) 55%, transparent);
    outline-offset: -1px;
  }
  .reveal-photo, .reveal-photo img { display: block; width: 100%; height: 100%; }
  .reveal-photo img { object-fit: contain; }
  .reveal-sketch {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 4%;
    background: var(--color-calce);
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
    will-change: clip-path;
  }
  .reveal-sketch picture { display: contents; }
  .reveal-sketch img {
    /* mai oltre la misura nativa dello schizzo */
    width: auto;
    height: auto;
    max-width: min(100%, var(--sw));
    max-height: min(100%, var(--sh));
    mix-blend-mode: multiply;
  }
  .reveal-rule {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 1px;
    background: var(--color-carbone);
    pointer-events: none;
  }
  .reveal-ticks { position: absolute; top: 0; left: 0; height: 100%; stroke: var(--color-carbone); stroke-width: 1; }
  .reveal-handle {
    position: absolute;
    top: 50%;
    /* la linea va fino al bordo, la maniglia resta sempre intera dentro il foglio */
    left: clamp(1.375rem, var(--pos), calc(100% - 1.375rem));
    width: 2.75rem;
    height: 2.75rem;
    transform: translate(-50%, -50%);
    display: grid;
    place-items: center;
    background: var(--color-calce);
    border: 1px solid var(--color-carbone);
    color: var(--color-carbone);
    transition: background-color 0.3s var(--ease-out-quint), color 0.3s var(--ease-out-quint);
  }
  .reveal-handle svg { fill: none; stroke: currentColor; stroke-width: 1.4; }
  .reveal-handle:focus-visible { outline: 2px solid var(--color-porfido); outline-offset: 3px; }
  .reveal[data-dragging] .reveal-handle, .reveal-handle:hover { background: var(--color-carbone); color: var(--color-calce); }
  .reveal-tag {
    position: absolute;
    top: 0.75rem;
    padding: 0.35rem 0.55rem;
    background: var(--color-calce);
    border: 1px solid color-mix(in oklch, var(--color-pietra) 70%, transparent);
    color: var(--color-carbone);
    transition: opacity 0.2s linear;
    cursor: pointer;
  }
  .reveal-tag-sketch { left: 0.75rem; opacity: clamp(0, calc(var(--p) * 6 - 0.4), 1); }
  .reveal-tag-built { right: 0.75rem; opacity: clamp(0, calc((1 - var(--p)) * 6 - 0.4), 1); }
  .reveal-caption { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.25rem 1.5rem; margin-top: 0.75rem; max-width: var(--pw, 100%); }
  .reveal-hint { color: var(--color-grigio); }
  .reveal[data-touched] .reveal-hint { opacity: 0; transition: opacity 0.8s var(--ease-out-quint); }
  @media (max-width: 767px) {
    .reveal-tag { top: 0.5rem; font-size: 0.66rem; }
    .reveal-tag-sketch { left: 0.5rem; }
    .reveal-tag-built { right: 0.5rem; }
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const easeOutExpo = (t: number) => (t === 1 ? 1 : 1 - Math.pow(2, -10 * t));

  document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((root) => {
    const stage = root.querySelector<HTMLElement>('[data-stage]')!;
    const handle = root.querySelector<HTMLElement>('[data-handle]')!;
    const lSketch = root.dataset.labelSketch!;
    const lBuilt = root.dataset.labelBuilt!.toLowerCase();
    let p = 0.5;
    let anim = 0;

    const set = (v: number) => {
      p = Math.min(1, Math.max(0, v));
      stage.style.setProperty('--pos', `${(p * 100).toFixed(2)}%`);
      stage.style.setProperty('--p', p.toFixed(4));
      const n = Math.round(p * 100);
      handle.setAttribute('aria-valuenow', String(n));
      handle.setAttribute('aria-valuetext', `${lSketch} ${n}%, ${lBuilt} ${100 - n}%`);
    };
    const tween = (to: number, ms: number, ease = easeOutExpo) => {
      cancelAnimationFrame(anim);
      if (reduce) { set(to); return; }
      const from = p, t0 = performance.now();
      const step = (now: number) => {
        const t = Math.min(1, (now - t0) / ms);
        set(from + (to - from) * ease(t));
        if (t < 1) anim = requestAnimationFrame(step);
      };
      anim = requestAnimationFrame(step);
    };
    const touched = () => { cancelAnimationFrame(anim); root.toggleAttribute('data-touched', true); };

    // trascinamento: mouse, penna e dito (lo scroll verticale resta al browser grazie a touch-action: pan-y)
    const fromX = (x: number) => { const r = stage.getBoundingClientRect(); return (x - r.left) / r.width; };
    stage.addEventListener('pointerdown', (e) => {
      if (e.button !== 0 || (e.target as HTMLElement).closest('[data-snap]')) return;
      touched();
      root.toggleAttribute('data-dragging', true);
      stage.setPointerCapture(e.pointerId);
      // con il mouse il primo clic salta al punto; con il dito si trascina dalla posizione attuale
      if (e.pointerType === 'mouse') set(fromX(e.clientX));
      else (stage as HTMLElement & { _ox?: number })._ox = fromX(e.clientX) - p;
    });
    stage.addEventListener('pointermove', (e) => {
      if (!root.hasAttribute('data-dragging')) return;
      const off = e.pointerType === 'mouse' ? 0 : ((stage as HTMLElement & { _ox?: number })._ox ?? 0);
      set(fromX(e.clientX) - off);
    });
    const end = (e: PointerEvent) => {
      root.removeAttribute('data-dragging');
      if (stage.hasPointerCapture(e.pointerId)) stage.releasePointerCapture(e.pointerId);
    };
    stage.addEventListener('pointerup', end);
    stage.addEventListener('pointercancel', end);

    // tastiera
    handle.addEventListener('keydown', (e) => {
      const big = e.shiftKey ? 0.1 : 0.02;
      const map: Record<string, number> = { ArrowLeft: p - big, ArrowDown: p - big, ArrowRight: p + big, ArrowUp: p + big, PageDown: p - 0.1, PageUp: p + 0.1, Home: 0, End: 1 };
      if (e.key in map) { e.preventDefault(); touched(); set(map[e.key]); }
    });

    // etichette: vanno al lato corrispondente
    root.querySelectorAll<HTMLElement>('[data-snap]').forEach((b) => b.addEventListener('click', () => { touched(); tween(Number(b.dataset.snap) / 100, 900); }));

    // ingresso: la linea attraversa il foglio una volta, come se l'edificio venisse disegnato
    set(reduce ? 0.5 : 0.94);
    if (!reduce) {
      const io = new IntersectionObserver((entries) => {
        if (entries.some((en) => en.isIntersecting)) {
          io.disconnect();
          if (!root.hasAttribute('data-touched')) tween(0.5, 1900);
          root.toggleAttribute('data-played', true);
        }
      }, { threshold: 0.45 });
      io.observe(stage);
    }
  });
</script>
